# FE runtime
VITE_API_BASE_URL=/api
VITE_AI_API_BASE_URL=/ai-api

# Vite proxy targets (dev only)
# Example: http://localhost:7000
API_PROXY_TARGET=
AI_API_PROXY_TARGET=

# Face recognition (WebSocket mode)
# Send interval: how often FE pushes a frame to the WS (ms). Lower = smoother.
# With REST polling the old default was 700; with WS 100-200 is recommended.
VITE_FACE_DETECT_INTERVAL_MS=150
VITE_FACE_DETECT_IMAGE_MAX_WIDTH=960
VITE_FACE_RECOGNITION_CAMERA_ID=frontend-camera
# Production default: AI server receives the full frame and handles tracking/voting/cache.
# Set to crop only when you want to A/B test client-side MediaPipe crop mode.
VITE_FACE_RECOGNITION_WS_MODE=stream